

SHORTPARSE_ENV=production
SHORTPARSE_DEBUG=false
SHORTPARSE_STORAGE_DIR=/storage/ShortParse/storage

# ==============================================================================
# Warcraft Logs API & OAuth Integration
# ==============================================================================
# Your client credentials from the Warcraft Logs API clients dashboard
WARCRAFTLOGS_CLIENT_ID=wcl_client_id_here
WARCRAFTLOGS_CLIENT_SECRET=wcl_client_secret_here

# The EXACT redirect URI registered in your Warcraft Logs client dashboard.
# (Since Nginx handles ssl and proxies /api to port 8000, use your live domain)
WARCRAFTLOGS_REDIRECT_URI=wcl_api_callback_url

# ==============================================================================
# Session & Cryptography Security
# ==============================================================================
# A secure, random string used to sign browser session cookies.
# (You can generate a secure hex key in terminal via: openssl rand -hex 32)
JWT_SECRET_KEY=random_string_goes_here

# ==============================================================================
# High-Speed Redis Cache
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Replace with the custom password you configured for your Redis Docker container
REDIS_PASSWORD=redis_password_goes_here

# ==============================================================================
# Patreon API & OAuth Integration
# ==============================================================================
PATREON_CLIENT_ID="your_patreon_client_id"
PATREON_CLIENT_SECRET="your_patreon_client_secret"
PATREON_REDIRECT_URI="http://localhost:8000/api/auth/patreon/callback"
PATREON_CAMPAIGN_ID="your_patreon_campaign_id"

# ==============================================================================
# Premium bypass - Add your Warcraft Logs display name (comma-separated if adding multiple users)
# ==============================================================================
BYPASS_PREMIUM_USERNAMES="Shortwire"

# ==============================================================================
# Premium feature toggles - to be enabled later
# ==============================================================================
PATREON_PRIORITY_QUEUE_ENABLED="false"

# ==============================================================================
# Gemini Chat Bot API Key
# ==============================================================================
GEMINI_API_KEY="your_gemini_api_key"